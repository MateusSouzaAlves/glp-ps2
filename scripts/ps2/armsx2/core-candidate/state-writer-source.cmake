# SPDX-License-Identifier: MIT
# Derived GPL core source, pinned and retained separately from upstream checkout.
# Initialize version padding and reject a failed ZIP source allocation before
# calling libzip with a null archive. No state layout/VM algorithm change.
set(original "${ARMSX2_SOURCE_DIR}/pcsx2/SaveState.cpp")
file(SHA256 "${original}" original_hash)
if(NOT original_hash STREQUAL "7660901a3ab420f5da3724d52615a93a262376dd6bee6adaf5c5a6d836e583a6")
    message(FATAL_ERROR "State writer source changed; re-audit")
endif()
file(READ "${original}" writer_source)
set(version_anchor "VersionIndicator* vi = static_cast<VersionIndicator*>(std::malloc(sizeof(VersionIndicator)));\n")
string(FIND "${writer_source}" "${version_anchor}" anchor_pos)
if(anchor_pos EQUAL -1)
    message(FATAL_ERROR "State version writer anchor changed")
endif()
string(REPLACE "${version_anchor}" "${version_anchor}\t\tif (!vi) return false;\n\t\tstd::memset(vi, 0, sizeof(*vi));\n" writer_source "${writer_source}")
set(zip_anchor "zip_t* zf = nullptr;\n\tif (zs && !(zf = zip_open_from_source")
string(REGEX MATCHALL "zip_t\\* zf = nullptr" declarations "${writer_source}")
list(LENGTH declarations declaration_count)
if(NOT declaration_count EQUAL 2)
    message(FATAL_ERROR "State ZIP allocation anchors changed")
endif()
string(REPLACE "${zip_anchor}" "zip_t* zf = nullptr;\n\tif (!zs) { Error::SetString(error, \"Failed to allocate state ZIP source\"); return false; }\n\tif (!(zf = zip_open_from_source" writer_source "${writer_source}")
set(derived "${CMAKE_BINARY_DIR}/derived/armsx2/SaveState.cpp")
file(WRITE "${derived}" "${writer_source}")
get_target_property(core_sources PCSX2 SOURCES)
if(NOT "SaveState.cpp" IN_LIST core_sources)
    message(FATAL_ERROR "State writer target source changed")
endif()
list(REMOVE_ITEM core_sources "SaveState.cpp")
list(APPEND core_sources "${derived}")
set_property(TARGET PCSX2 PROPERTY SOURCES "${core_sources}")
set_source_files_properties("${derived}" PROPERTIES INCLUDE_DIRECTORIES "${ARMSX2_SOURCE_DIR}/pcsx2")
