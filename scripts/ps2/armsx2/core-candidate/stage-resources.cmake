# Private generated runtime tree. Validate the entire closure before copying.
cmake_minimum_required(VERSION 3.22)
if(NOT ARMSX2_RESOURCE_MANIFEST OR NOT ARMSX2_SOURCE_DIR OR NOT ARMSX2_RUNTIME_DIR)
    message(FATAL_ERROR "Explicit manifest, verified source and generated runtime directory required")
endif()
file(READ "${ARMSX2_RESOURCE_MANIFEST}" manifest)
string(JSON resource_revision GET "${manifest}" revision)
if(NOT resource_revision STREQUAL source_revision)
    message(FATAL_ERROR "Resource/core revision mismatch")
endif()
string(JSON count LENGTH "${manifest}" files)
if(count LESS 1 OR count GREATER 128)
    message(FATAL_ERROR "Invalid resource count")
endif()
math(EXPR last "${count} - 1")
set(destinations)
set(folded_destinations)
foreach(index RANGE 0 ${last})
    string(JSON relative GET "${manifest}" files ${index} source)
    string(JSON destination GET "${manifest}" files ${index} destination)
    string(JSON expected_hash GET "${manifest}" files ${index} sha256)
    string(JSON expected_bytes GET "${manifest}" files ${index} bytes)
    foreach(path IN ITEMS "${relative}" "${destination}")
        if(NOT path MATCHES "^[A-Za-z0-9_./-]+$" OR path MATCHES "(^|/)[.]+(/|$)" OR path MATCHES "^/|//")
            message(FATAL_ERROR "Unsafe resource path")
        endif()
    endforeach()
    set(android_patches "platforms/android/app/src/main/assets/resources/patches.zip")
    if(relative STREQUAL android_patches AND NOT destination STREQUAL "patches.zip")
        message(FATAL_ERROR "Android core patches must retain their runtime name")
    endif()
    if(NOT relative MATCHES "^bin/resources(-overlay)?/" AND NOT relative STREQUAL android_patches)
        message(FATAL_ERROR "Source outside resource closure")
    endif()
    string(TOLOWER "${destination}" folded)
    if(folded IN_LIST folded_destinations)
        message(FATAL_ERROR "Duplicate resource destination")
    endif()
    list(APPEND destinations "${destination}")
    list(APPEND folded_destinations "${folded}")
    string(LENGTH "${expected_hash}" hash_length)
    if(NOT hash_length EQUAL 64 OR NOT expected_hash MATCHES "^[0-9a-f]+$" OR NOT expected_bytes MATCHES "^[0-9]+$")
        message(FATAL_ERROR "Invalid resource metadata")
    endif()
    set(input "${ARMSX2_SOURCE_DIR}/${relative}")
    if(NOT EXISTS "${input}" OR IS_DIRECTORY "${input}" OR IS_SYMLINK "${input}")
        message(FATAL_ERROR "Missing/nonregular resource: ${relative}")
    endif()
    file(REAL_PATH "${input}" real_input)
    string(FIND "${real_input}" "${ARMSX2_SOURCE_DIR}/bin/" inside_source)
    if(NOT inside_source EQUAL 0 AND NOT real_input STREQUAL "${ARMSX2_SOURCE_DIR}/${android_patches}")
        message(FATAL_ERROR "Resource escapes verified source")
    endif()
    file(SIZE "${input}" actual_bytes)
    file(SHA256 "${input}" actual_hash)
    if(NOT actual_bytes EQUAL expected_bytes OR NOT actual_hash STREQUAL expected_hash)
        message(FATAL_ERROR "Changed resource: ${relative}")
    endif()
endforeach()
# This is a build directory, not an app data folder. Refuse unknown contents
# instead of deleting them or importing a stale resource from a previous core.
set(resource_output "${ARMSX2_RUNTIME_DIR}/pcsx2/resources")
set(parent "${resource_output}")
while(NOT parent STREQUAL "${CMAKE_BINARY_DIR}" AND NOT parent STREQUAL "")
    if(IS_SYMLINK "${parent}")
        message(FATAL_ERROR "Symlink in generated runtime path")
    endif()
    get_filename_component(next_parent "${parent}" DIRECTORY)
    if(parent STREQUAL next_parent)
        break()
    endif()
    set(parent "${next_parent}")
endwhile()
file(GLOB_RECURSE existing LIST_DIRECTORIES FALSE RELATIVE "${resource_output}" "${resource_output}/*")
foreach(path IN LISTS existing)
    if(NOT path IN_LIST destinations)
        message(FATAL_ERROR "Uninventoried generated resource: ${path}")
    endif()
endforeach()
# Check every output parent before any copy, including nested directories.
foreach(destination IN LISTS destinations)
    set(parent "${resource_output}/${destination}")
    while(NOT parent STREQUAL resource_output)
        if(IS_SYMLINK "${parent}")
            message(FATAL_ERROR "Symlink in generated resource destination")
        endif()
        get_filename_component(parent "${parent}" DIRECTORY)
    endwhile()
endforeach()
foreach(index RANGE 0 ${last})
    string(JSON relative GET "${manifest}" files ${index} source)
    string(JSON destination GET "${manifest}" files ${index} destination)
    get_filename_component(parent "${resource_output}/${destination}" DIRECTORY)
    file(MAKE_DIRECTORY "${parent}")
    configure_file("${ARMSX2_SOURCE_DIR}/${relative}" "${resource_output}/${destination}" COPYONLY)
endforeach()
message(STATUS "Verified ${count} ARMSX2 resources; no BIOS/ROM or frontend assets copied")
